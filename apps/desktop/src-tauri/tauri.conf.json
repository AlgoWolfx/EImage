{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EIMAGE",
  "version": "0.1.0",
  "identifier": "com.egoradigital.eimage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EIMAGE",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Capture, annotate and share screenshots locally",
    "longDescription": "Free and open-source screenshot capture and annotation. No account, uploads, subscriptions or watermark.",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../../docs/THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../LICENSE": "licenses/LICENSE"
    },
    "license": "MIT",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libpipewire-0.3-0t64",
          "libgbm1",
          "libxcb1",
          "libwayland-client0",
          "libwayland-server0",
          "libdbus-1-3"
        ]
      }
    }
  }
}
