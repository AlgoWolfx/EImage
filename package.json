{
  "name": "eimage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts --host 0.0.0.0 --port 5175",
    "dev:site": "vite --config apps/website/vite.config.ts --host 0.0.0.0 --port 5176",
    "desktop": "node scripts/tauri.mjs dev",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts && vite build --config apps/website/vite.config.ts && node scripts/seo.mjs",
    "build:desktop": "node scripts/tauri.mjs build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview:site": "vite preview --config apps/website/vite.config.ts --host 127.0.0.1 --port 4176 --strictPort",
    "preview:editor": "vite preview --config apps/desktop/vite.config.ts --host 127.0.0.1 --port 4175 --strictPort"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
